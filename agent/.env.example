# Copy to agent/.env and fill in. Never commit .env.
# Bun loads agent/.env automatically when you run `bun run start` from the agent/ folder.

# --- Required (the agent refuses to start without all of these, even for web-chat-only use) ---
# Google AI Studio key
GEMINI_API_KEY=
# From the Photon dashboard
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# imessage or email
PHOTON_PLATFORM=imessage
# The agent's iMessage number / email handle in Photon
PHOTON_AGENT_HANDLE=
# YOUR phone number / email: the only sender the agent answers on Photon
PHOTON_TEST_SENDER=

# --- Optional ---
# Default in code is gemini-3.8-flash; set a model your key can use if that one fails
# GEMINI_MODEL=
# off = don't text first when the agent starts
# GREET_ON_START=off
# off = disable the website chat endpoint
# WEB_CHAT=off
# WEB_CHAT_PORT=8787
# Comma-separated site addresses allowed to call /chat. http://localhost:* and http://127.0.0.1:* are always allowed.
# WEB_CHAT_ORIGINS=https://sbuhacks26.vercel.app
# HEALTH_RESOURCE_NAME=
# HEALTH_RESOURCE_URL=
